    "text": "require \"json\"\nrequire \"set\"\nrequire_relative \"base\"\n\n# A client.\nclass Client < Base\n  LIMIT = 10\n\n  def initialize(total)\n    @total = total\n  end\n\n  def charge(amount)\n    @total + amount + 1\n  end\n\n  def self.make\n    new(1)\n  end\n\n  class << self\n    def other\n      1\n    end\n  end\nend\n\nmodule Shape\n  def area\n    1\n  end\n\n  def side\n    2\n  end\nend\n\ndef top(x)\n  x + 1\nend\n\ndescribe \"client\" do\n  it \"charges\" do\n    expect(1).to eq(1)\n  end\n\n  xit \"refunds\" do\n    expect(1).to eq(2)\n  end\nend\n\nclass ClientTest < Minitest::Test\n  def test_charge\n    assert true\n  end\n\n  def test_later\n    skip\n  end\nend\n"
