    "text": "package app\n\nimport java.util.UUID\nimport java.util.Date\n\n/** A client. */\nclass Client(val id: Int) {\n    val total: Int = 0\n\n    constructor() : this(0)\n\n    fun charge(amount: Int): Int {\n        return total + amount + 1\n    }\n\n    fun charge(amount: Long, why: String): Int {\n        return total - 1\n    }\n\n    companion object {\n        fun make() = Client()\n    }\n\n    @Test\n    @Ignore\n    fun chargesOnce() {\n        assert(charge(1) == 1)\n    }\n}\n\nenum class State {\n    OPEN,\n    SHUT;\n\n    fun open() = this == OPEN\n}\n\nfun top(x: Int) = x + 1\n\nfun other() = 2\n"
