    "text": "import Foundation\nimport Combine\n\n/// A client.\npublic class Client {\n    let id: Int = 0\n    var total = 0\n\n    init(total: Int) {\n        self.total = total\n    }\n\n    deinit {\n        stop()\n    }\n\n    func charge(amount: Int) -> Int {\n        return total + amount + 1\n    }\n\n    func charge(amount: Int64, why: String) -> Int {\n        return total - 1\n    }\n\n    func testCharge() {\n        assert(true)\n    }\n\n    @Test func marked() {\n        assert(true)\n    }\n}\n\nextension Client {\n    func more() -> Int {\n        return 2\n    }\n\n    func again() -> Int {\n        return 3\n    }\n}\n\nextension Client: Equatable {\n    func eq() -> Bool {\n        return true\n    }\n}\n\nstruct Point {\n    var x: Int\n\n    func sum() -> Int {\n        return x\n    }\n}\n\nprotocol Shape {\n    func area() -> Double\n    var name: String { get }\n}\n\ntypealias Name = String\n\nfunc top(x: Int) -> Int {\n    return x + 1\n}\n"
