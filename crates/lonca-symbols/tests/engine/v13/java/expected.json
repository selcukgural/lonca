    "text": "package app;\n\nimport java.util.List;\nimport java.util.Map;\n\n/** A client. */\npublic class Client {\n    private int total = 0;\n\n    public Client(int total) {\n        this.total = total;\n    }\n\n    int charge(int amount) {\n        return total + amount + 1;\n    }\n\n    int charge(long amount, String why) {\n        return total - 1;\n    }\n\n    enum State {\n        OPEN, SHUT;\n\n        boolean open() {\n            return this != SHUT;\n        }\n    }\n\n    int refund() {\n        return 0;\n    }\n\n    @Test\n    @Disabled\n    void chargesOnce() {\n        assert charge(1) == 1;\n    }\n}\n"
