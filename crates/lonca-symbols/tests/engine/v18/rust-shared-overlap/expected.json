    "text": "pub struct Ledger {\n    entries: Vec<u64>,\n}\n\nimpl Ledger {\n    /// Adds up what is due.\n    pub fn total(&self, fee: u64) -> u64 {\n        let mut sum = 0;\n        for e in &self.entries {\n            sum += e;\n        }\n        let fee = fee;\n        sum + fee + 1\n    }\n\n    pub fn count(&self) -> usize {\n        self.entries.len()\n    }\n}\n"
